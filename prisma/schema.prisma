// SecureShip AI data model.
// INVARIANT: no column stores a secret value. Secret findings keep only a
// one-way fingerprint plus rule/location metadata.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum Scanner {
  GITLEAKS
  TRIVY
  SEMGREP
}

enum FindingKind {
  SECRET
  VULNERABILITY
  SAST
  MISCONFIG
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  REMEDIATED
  FALSE_POSITIVE
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  BLOCKED
  CANCELLED
}

enum PolicyOutcome {
  ALLOW
  BLOCK
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  createdAt    DateTime     @default(now())
  repositories Repository[]
}

model Repository {
  id            String         @id @default(cuid())
  fullName      String         @unique // "owner/repo"
  defaultBranch String         @default("main")
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo        Boolean        @default(false) // true = seeded demonstration data
  createdAt     DateTime       @default(now())
  runs          PipelineRun[]
  findings      Finding[]
  deployments   Deployment[]
  notifications Notification[]
  auditEvents   AuditEvent[]

  @@index([ownerId])
}

model PipelineRun {
  id             String          @id @default(cuid())
  repositoryId   String
  repository     Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubRunId    String?
  branch         String
  commitSha      String
  actor          String
  status         RunStatus       @default(QUEUED)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  findings       Finding[]
  policyDecision PolicyDecision?
  deployments    Deployment[]
  notifications  Notification[]

  @@unique([repositoryId, githubRunId])
  @@index([repositoryId, startedAt])
}

model Finding {
  id            String         @id @default(cuid())
  runId         String
  run           PipelineRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  repositoryId  String
  repository    Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  scanner       Scanner
  kind          FindingKind
  severity      Severity
  ruleId        String
  title         String
  filePath      String?
  startLine     Int?
  endLine       Int?
  fingerprint   String // SHA-256 based; never reversible to the secret
  status        FindingStatus  @default(OPEN)
  aiExplanation String?
  aiSuggestion  String?
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([runId])
  @@index([repositoryId, status])
  @@index([fingerprint])
}

model PolicyDecision {
  id            String        @id @default(cuid())
  runId         String        @unique
  run           PipelineRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  policyVersion String
  outcome       PolicyOutcome
  reasons       Json
  createdAt     DateTime      @default(now())
}

model Deployment {
  id              String           @id @default(cuid())
  repositoryId    String
  repository      Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runId           String?
  run             PipelineRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  environment     String
  imageRef        String
  imageDigest     String?
  status          DeploymentStatus @default(PENDING)
  healthCheckOk   Boolean?
  rolledBackToRef String?
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?

  @@index([repositoryId, startedAt])
}

model Notification {
  id                String             @id @default(cuid())
  repositoryId      String
  repository        Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runId             String?
  run               PipelineRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  findingId         String?
  finding           Finding?           @relation(fields: [findingId], references: [id], onDelete: SetNull)
  channel           String             @default("EMAIL")
  recipient         String
  subject           String
  status            NotificationStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?

  @@index([repositoryId, createdAt])
}

model AuditEvent {
  id           String      @id @default(cuid())
  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  actor        String
  action       String
  entityType   String
  entityId     String?
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([repositoryId, createdAt])
}
